# Copy to .env (cp .env.example .env) and edit. Never commit .env: it holds secrets.

# The database password. Generate one: openssl rand -hex 24   (hex only: it goes into a URL)
POSTGRES_PASSWORD=CHANGE-ME-generate-with-openssl-rand-hex-24

# The public name of the site. A DNS record must point at this machine (ports 80 and 443 open):
# Caddy gets the certificate for it. It is also the only Host that Forgebase accepts.
FORGEBASE_DOMAIN=forgebase.example.com

# Optional ----------------------------------------------------------------------------------

# Which binary the image runs: `sales` (the demo app) or another binary of this workspace.
#FORGEBASE_BIN=sales

# Host directory for `site backup` files; it must be writable by uid 10001:
#   sudo install -d -o 10001 -g 10001 -m 700 /var/backups/forgebase
#BACKUP_DIR=/var/backups/forgebase

# Run `migrate` when serve starts (off by default; the guide recommends running it by hand).
#FORGEBASE_MIGRATE_ON_START=1

# Testing without a domain, over plain HTTP. INSECURE: the session cookie loses its Secure flag and
# passwords travel unencrypted. Use a throw-away VM and never real data. Use the IP as the site:
#FORGEBASE_DOMAIN=http://203.0.113.10
#FORGEBASE_ALLOWED_HOSTS=203.0.113.10
#FORGEBASE_DEV_INSECURE_COOKIES=1
